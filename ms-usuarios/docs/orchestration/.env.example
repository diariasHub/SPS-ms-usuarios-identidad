# =========================================================================
# Variables compartidas por el docker-compose orquestador.
# Copia este archivo como `.env` en el repo de orquestación y rellena valores.
# NO commitear el .env real al repositorio.
# =========================================================================

# ----- PostgreSQL central (compartido por todos los MS, con BDs separadas) -----
POSTGRES_USER=rednorte
POSTGRES_PASSWORD=cambiar-en-prod
# Esta es la BD por defecto que crea el contenedor de Postgres al primer arranque.
# Las BDs por servicio (hapi_fhir, db_ms_usuarios, ...) las crea ./initdb/01-create-databases.sh
POSTGRES_DB=rednorte

# Credenciales que usan los MS para conectarse (pueden ser las mismas o
# usuarios dedicados creados por el script de init).
DB_USER=${POSTGRES_USER}
DB_PASSWORD=${POSTGRES_PASSWORD}

# ----- HAPI FHIR central (fuente de verdad de recursos clínicos) -----
# URL que los MS de negocio usan para hablar con HAPI dentro de la red Docker.
FHIR_SERVER_URL=http://hapi-fhir:8080/fhir

# ----- IdP (OAuth2) -----
# Cuando esté Keycloak local en compose, apuntar al realm correspondiente.
# Mientras tanto, ms-usuarios-identidad puede correr en perfil dev (firma propia).
IDP_ISSUER_URI=http://keycloak:8080/realms/rednorte
IDP_JWK_SET_URI=http://keycloak:8080/realms/rednorte/protocol/openid-connect/certs

# ----- Perfil de Spring por MS (override por servicio si necesario) -----
# Por defecto cada MS arranca con SPRING_PROFILES_ACTIVE=prod definido en compose.
